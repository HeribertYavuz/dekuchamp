[Version]
Signature           = "$WINDOWS NT$"
Class               = USB
ClassGuid           = {36FC9E60-C465-11CF-8056-444553540000}
DriverPackageType   = ClassFilter
Provider            = %PROVIDER%
CatalogFile.NTx86   = Dekuchampx86.cat
CatalogFile.NTamd64 = Dekuchampamd64.cat

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskId1%,,,"."

[SourceDisksFiles]
Dekuchamp.sys = 1,,

[DefaultInstall.NTx86]
CopyFiles = @Dekuchamp.sys
AddReg    = Dekuchamp.AddReg

[DefaultUninstall.NTx86]
DelFiles  = @Dekuchamp.sys
DelReg    = Dekuchamp.DelReg

[DefaultInstall.NTamd64]
CopyFiles = @Dekuchamp.sys
AddReg    = Dekuchamp.AddReg

[DefaultUninstall.NTamd64]
DelFiles  = @Dekuchamp.sys
DelReg    = Dekuchamp.DelReg

[Dekuchamp.AddReg]
;Add Dekuchamp to UpperFilters
HKLM, System\CurrentControlSet\Control\Class\{36FC9E60-C465-11CF-8056-444553540000}, UpperFilters, 0x00010008, Dekuchamp

[Dekuchamp.DelReg]
;Delete Dekuchamp from UpperFilters
HKLM, System\CurrentControlSet\Control\Class\{36FC9E60-C465-11CF-8056-444553540000}, UpperFilters, 0x00018002, Dekuchamp

[DefaultInstall.NTx86.Services]
AddService = Dekuchamp,,Service.AddService

[DefaultUninstall.NTx86.Services]
DelService = Dekuchamp,0x00000200

[DefaultInstall.NTamd64.Services]
AddService = Dekuchamp,,Service.AddService

[DefaultUninstall.NTamd64.Services]
DelService = Dekuchamp,0x00000200

[Service.AddService]
DisplayName    = %Dekuchamp.SvcDesc%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 2               ; SERVICE_ERROR_SEVERE
ServiceBinary  = %12%\Dekuchamp.sys

[Strings]
PROVIDER             = "Dekuchamp"
StdMfg               = "Dekuchamp Developers"
DiskId1              = "Dekuchamp Installation Disk #1"
Dekuchamp.DeviceDesc   = "Dekuchamp Filter Driver"
Dekuchamp.SvcDesc      = "Dekuchamp Capture Service"

